  "razorpaySignature": "signature_here",
  "courseId": "69facd23fd71219b0b747bd2"
}

###

### Get Payment History
GET http://localhost:5000/api/payment/history
Content-Type: application/json
Authorization: Bearer REPLACE_WITH_TOKEN_FROM_TEST_LOGIN

