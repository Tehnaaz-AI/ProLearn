### ============================================================================
### QUIZ MODULE (Requires Auth)
### ============================================================================

### Create Quiz (Use Instructor Token)
POST http://localhost:5000/api/quiz/create
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6IjY5ZmIwNWU4MjcwY2EzNmYxOWJhOTI0MSIsInJvbGUiOiJpbnN0cnVjdG9yIiwicm9sZXMiOlsic3R1ZGVudCIsImluc3RydWN0b3IiXSwiaWF0IjoxNzc4MTI2Nzg3LCJleHAiOjE3Nzg3MzE1ODd9.x1LlhIbujdjYlcz4hpN48ACF7YsGXFZy4gkdjhkf0RI

{
  "courseId": "69facd23fd71219b0b747bd2",
  "topic": "JavaScript Fundamentals",
  "title": "JS Basics Quiz",
  "maxAttempts": 3,
  "questions": [
    {
      "questionText": "What is the output of console.log(2 + '2')?",
      "options": ["4", "'22'", "22", "Error"],
      "correctIndex": 1,
      "explanation": "String concatenation in JavaScript"
    },
    {
      "questionText": "Which keyword declares a block-scoped variable?",
      "options": ["var", "let", "const", "both let and const"],
      "correctIndex": 3,
      "explanation": "Both let and const are block-scoped"
    }
  ]
}

###

